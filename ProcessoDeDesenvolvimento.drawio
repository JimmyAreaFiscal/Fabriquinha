        <mxCell id="r_LA35FQatkXShZi-ib0-30" value="ImplementarSolucao" style="shape=mxgraph.signs.tech.computer;html=1;pointerEvents=1;verticalLabelPosition=bottom;verticalAlign=top;align=left;sketch=0;labelPosition=right;" vertex="1" parent="1">
          <mxGeometry x="630" y="992" width="50" height="58" as="geometry" />
        </mxCell>
        <mxCell id="r_LA35FQatkXShZi-ib0-32" value="&lt;h2 style=&quot;margin-top: 0px;&quot;&gt;ImplementarSolucao&lt;/h2&gt;&lt;p&gt;&lt;/p&gt;&lt;h3&gt;Objetivo&lt;/h3&gt;O objetivo nesta etapa é implementar a solução desenhada anteriormente&lt;br&gt;&lt;br&gt;&lt;h3&gt;Problemas atuais: &lt;/h3&gt;1) implementação parcial ou com bug&lt;br&gt;2) alteração dos testes e2e e de integração&lt;div&gt;3) adição de complexidade acidental&amp;nbsp;&lt;/div&gt;&lt;div&gt;4) adição de acoplamento&lt;/div&gt;&lt;div&gt;5) adição de bad smells&lt;br&gt;&lt;br&gt;&lt;h3&gt;Evidências&lt;/h3&gt;&lt;div&gt;1) Aprovação dos testes (todos)&lt;/div&gt;&lt;div&gt;2) SAST (SonarQube)&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;h3&gt;Métricas de Sucesso&lt;/h3&gt;&lt;/div&gt;&lt;div&gt;1) Quantidade de token/modelo e&amp;nbsp; custo total&amp;nbsp;&lt;/div&gt;&lt;div&gt;2) Quantidade de alterações posteriores no código desenvolvido&lt;/div&gt;&lt;p&gt;&lt;/p&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="705" y="1101" width="290" height="430" as="geometry" />
        </mxCell>
        <mxCell id="r_LA35FQatkXShZi-ib0-33" value="Execução dos Testes" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;size=15;labelPosition=center;verticalLabelPosition=bottom;align=center;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="240" y="1121" width="40" height="50" as="geometry" />

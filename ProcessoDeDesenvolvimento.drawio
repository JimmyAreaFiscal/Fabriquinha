            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="erd_rel_25" edge="1" parent="1" source="XcyZCd-SjGrCP0lY6zEm-98" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;fontSize=12;labelBackgroundColor=#ffffff;endFill=0;startFill=0;startArrow=ERzeroToOne;endArrow=ERzeroToMany;exitX=0;exitY=0.3;entryX=1;entryY=0.2;" target="XcyZCd-SjGrCP0lY6zEm-54" value="dono ticket">

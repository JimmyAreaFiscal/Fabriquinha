        <mxCell id="TuZLYwPetvcthj7BLmxr-3" parent="r_LA35FQatkXShZi-ib0-90" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=default;labelBackgroundColor=none;" value="&lt;h2 style=&quot;margin-top: 0px;&quot;&gt;&lt;span&gt;Planejamento e Desenho&lt;/span&gt;&lt;/h2&gt;&lt;p&gt;&lt;/p&gt;&lt;h3&gt;&lt;span&gt;Objetivo&lt;/span&gt;&lt;/h3&gt;&lt;span&gt;O objetivo nesta etapa é entender a necessidade/funcionalidade e realizar um desenho.&lt;br&gt;&lt;br&gt;&lt;/span&gt;&lt;h3&gt;&lt;span&gt;Problemas atuais: &lt;/span&gt;&lt;/h3&gt;&lt;span&gt;1) Necessidade de autonomia para desenhar e explorar&lt;br&gt;2) Falta de mensuração dos custos desta fase&amp;nbsp;&lt;/span&gt;&lt;div&gt;&lt;span&gt;3) Falta de visão global sobre o que deve ser implementado&lt;br&gt;&lt;br&gt;&lt;/span&gt;&lt;h3&gt;&lt;span&gt;Evidências&lt;/span&gt;&lt;/h3&gt;&lt;div&gt;&lt;span&gt;1) Critérios de Aceite&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;2) Desenho da Solução&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;&lt;br&gt;&lt;/span&gt;&lt;h3&gt;&lt;span&gt;Métricas de Sucesso&lt;/span&gt;&lt;/h3&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;1) Quantidade de token/modelo e&amp;nbsp; custo total&amp;nbsp;&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span&gt;2) Quantidade de aprovações/reprovações&lt;/span&gt;&lt;/div&gt;&lt;p&gt;&lt;/p&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="389" width="325" x="331" y="420" as="geometry" />
        </mxCell>

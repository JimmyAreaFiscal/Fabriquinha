        <mxCell id="vida_cli" parent="1" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;size=60;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fontSize=16;align=center;fillColor=#f5f5f5;strokeColor=#666666;" value="«interface»&lt;br&gt;&lt;b&gt;CLI&lt;/b&gt;" vertex="1">
          <mxGeometry height="10131" width="230" x="55" y="150" as="geometry" />
        </mxCell>
        <mxCell id="vida_http" parent="1" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;size=60;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fontSize=16;align=center;fillColor=#f5f5f5;strokeColor=#666666;" value="«interface»&lt;br&gt;&lt;b&gt;HTTP&lt;/b&gt;" vertex="1">
          <mxGeometry height="10131" width="230" x="345" y="150" as="geometry" />
        </mxCell>
        <mxCell id="vida_demanda" parent="1" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;size=60;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fontSize=16;align=center;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="«serviço de aplicação»&lt;br&gt;&lt;b&gt;Gestão de Demandas&lt;/b&gt;" vertex="1">
          <mxGeometry height="10131" width="230" x="635" y="150" as="geometry" />
        </mxCell>
        <mxCell id="vida_execucao" parent="1" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;size=60;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fontSize=16;align=center;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="«serviço de aplicação»&lt;br&gt;&lt;b&gt;Execução&lt;/b&gt;" vertex="1">
          <mxGeometry height="10131" width="230" x="925" y="150" as="geometry" />
        </mxCell>
        <mxCell id="vida_planejamento" parent="1" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;size=60;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fontSize=16;align=center;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="«serviço de aplicação»&lt;br&gt;&lt;b&gt;Planejamento&lt;/b&gt;" vertex="1">
          <mxGeometry height="10131" width="230" x="1215" y="150" as="geometry" />
        </mxCell>
        <mxCell id="vida_implementacao" parent="1" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;size=60;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fontSize=16;align=center;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="«serviço de aplicação»&lt;br&gt;&lt;b&gt;Implementação&lt;/b&gt;" vertex="1">
          <mxGeometry height="10131" width="230" x="1505" y="150" as="geometry" />
        </mxCell>
        <mxCell id="vida_revisao" parent="1" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;size=60;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fontSize=16;align=center;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="«serviço de aplicação»&lt;br&gt;&lt;b&gt;Revisão&lt;/b&gt;" vertex="1">
          <mxGeometry height="10131" width="230" x="1795" y="150" as="geometry" />
        </mxCell>
        <mxCell id="vida_encerramento" parent="1" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;size=60;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fontSize=16;align=center;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="«serviço de aplicação»&lt;br&gt;&lt;b&gt;Encerramento&lt;/b&gt;" vertex="1">
          <mxGeometry height="10131" width="230" x="2085" y="150" as="geometry" />
        </mxCell>
        <mxCell id="vida_ajustes" parent="1" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;size=60;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;fontSize=16;align=center;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="«serviço de aplicação»&lt;br&gt;&lt;b&gt;Ajustes de PR&lt;/b&gt;" vertex="1">
          <mxGeometry height="10131" width="230" x="2375" y="150" as="geometry" />
        </mxCell>
        <mxCell id="texto_206" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=7;fontSize=15;fontSize=25;fontStyle=1;" value="Ciclo completo da demanda — sequência dos serviços de aplicação" vertex="1">
          <mxGeometry height="45" width="2610" x="30" y="15" as="geometry" />
        </mxCell>
        <mxCell id="texto_207" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=7;fontSize=15;fillColor=#f5f5f5;strokeColor=#999999;fontSize=14;" value="Leitura de cima para baixo. Apenas CLI, HTTP e os sete serviços aprovados. Setas contínuas: operações/coordenação; tracejadas: resultados. Fragmentos alt/opt/loop/break delimitam alternativas, repetição e término. Nenhum endpoint ou transporte interno é presumido." vertex="1">
          <mxGeometry height="60" width="2610" x="30" y="70" as="geometry" />
        </mxCell>
        <mxCell id="texto_1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=7;fontSize=15;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=19;" value="1 · Registrar e enviar a demanda — UC-DEM-01" vertex="1">
          <mxGeometry height="42" width="2610" x="30" y="240" as="geometry" />
        </mxCell>
        <mxCell id="texto_2" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=7;fontSize=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" value="CLI: IA externa no registro; agente nas etapas internas. HTTP: ações do Auditor no web. O entendimento da necessidade acontece antes desta sequência." vertex="1">
          <mxGeometry height="48" width="2550" x="55" y="302" as="geometry" />
        </mxCell>
        <mxCell id="texto_9" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=7;fontSize=15;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=19;" value="2 · Decidir a demanda — UC-DEM-02" vertex="1">
          <mxGeometry height="42" width="2610" x="30" y="999" as="geometry" />
        </mxCell>
        <mxCell id="texto_12" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=7;fontSize=15;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=19;" value="3 · Planejar e aprovar o planejamento — UC-PLAN-01/02" vertex="1">
          <mxGeometry height="42" width="2610" x="30" y="1543" as="geometry" />
        </mxCell>
        <mxCell id="texto_13" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=7;fontSize=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" value="Execução seleciona trabalho elegível a cada disparo interno ou por HTTP → Executar agora. Respeita dependências e concorrência; o agente não escolhe o próximo trabalho." vertex="1">
          <mxGeometry height="48" width="2550" x="55" y="1605" as="geometry" />
        </mxCell>
        <mxCell id="texto_26" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=7;fontSize=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" value="Se a preparação da aprovação falhar, o gate permanece aberto: não se confirma a aprovação nem se inicia o desenvolvimento." vertex="1">
          <mxGeometry height="48" width="2550" x="55" y="2929" as="geometry" />
        </mxCell>
        <mxCell id="texto_27" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=7;fontSize=15;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=19;" value="4 · Executar as rodadas — UC-IMPL-01, UC-REV-01, UC-ENC-01/02, UC-SES-01" vertex="1">
          <mxGeometry height="42" width="2610" x="30" y="3053" as="geometry" />
        </mxCell>
        <mxCell id="cabecalho_28" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;" value="CLI" vertex="1">
          <mxGeometry height="40" width="230" x="55" y="3115" as="geometry" />
        </mxCell>
        <mxCell id="cabecalho_29" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;" value="HTTP" vertex="1">
          <mxGeometry height="40" width="230" x="345" y="3115" as="geometry" />
        </mxCell>
        <mxCell id="cabecalho_30" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Gestão de Demandas" vertex="1">
          <mxGeometry height="40" width="230" x="635" y="3115" as="geometry" />
        </mxCell>
        <mxCell id="cabecalho_31" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Execução" vertex="1">
          <mxGeometry height="40" width="230" x="925" y="3115" as="geometry" />
        </mxCell>
        <mxCell id="cabecalho_32" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Planejamento" vertex="1">
          <mxGeometry height="40" width="230" x="1215" y="3115" as="geometry" />
        </mxCell>
        <mxCell id="cabecalho_33" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Implementação" vertex="1">
          <mxGeometry height="40" width="230" x="1505" y="3115" as="geometry" />
        </mxCell>
        <mxCell id="cabecalho_34" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Revisão" vertex="1">
          <mxGeometry height="40" width="230" x="1795" y="3115" as="geometry" />
        </mxCell>
        <mxCell id="cabecalho_35" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Encerramento" vertex="1">
          <mxGeometry height="40" width="230" x="2085" y="3115" as="geometry" />
        </mxCell>
        <mxCell id="cabecalho_36" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Ajustes de PR" vertex="1">
          <mxGeometry height="40" width="230" x="2375" y="3115" as="geometry" />
        </mxCell>
        <mxCell id="texto_37" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=7;fontSize=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" value="Uma rodada é expandida por legibilidade. Rodadas independentes podem executar em paralelo, com uma execução por rodada. Correções percorrem novamente implementação → revisão → encerramento." vertex="1">
          <mxGeometry height="48" width="2550" x="55" y="3177" as="geometry" />
        </mxCell>
        <mxCell id="texto_38" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=7;fontSize=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" value="Implementação não recebe um comando CLI de submissão: o agente termina a resposta e a aplicação verifica o resultado." vertex="1">
          <mxGeometry height="48" width="2550" x="55" y="3487" as="geometry" />
        </mxCell>
        <mxCell id="texto_41" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=7;fontSize=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" value="Reabrir não dispara imediatamente. A próxima seleção elegível retoma a mesma sessão; o trabalho existente é preservado." vertex="1">
          <mxGeometry height="48" width="2550" x="55" y="4054" as="geometry" />
        </mxCell>
        <mxCell id="texto_50" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=7;fontSize=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" value="Ajustes de PR não espera o agendador. Nesta conversa não há implementação nem integração." vertex="1">
          <mxGeometry height="48" width="2550" x="55" y="5380" as="geometry" />
        </mxCell>
        <mxCell id="texto_71" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=7;fontSize=15;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=19;" value="5 · Revisar a demanda inteira — UC-REV-02" vertex="1">
          <mxGeometry height="42" width="2610" x="30" y="6514" as="geometry" />
        </mxCell>
        <mxCell id="cabecalho_72" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;" value="CLI" vertex="1">
          <mxGeometry height="40" width="230" x="55" y="6576" as="geometry" />
        </mxCell>
        <mxCell id="cabecalho_73" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;" value="HTTP" vertex="1">
          <mxGeometry height="40" width="230" x="345" y="6576" as="geometry" />
        </mxCell>
        <mxCell id="cabecalho_74" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Gestão de Demandas" vertex="1">
          <mxGeometry height="40" width="230" x="635" y="6576" as="geometry" />
        </mxCell>
        <mxCell id="cabecalho_75" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Execução" vertex="1">
          <mxGeometry height="40" width="230" x="925" y="6576" as="geometry" />
        </mxCell>
        <mxCell id="cabecalho_76" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Planejamento" vertex="1">
          <mxGeometry height="40" width="230" x="1215" y="6576" as="geometry" />
        </mxCell>
        <mxCell id="cabecalho_77" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Implementação" vertex="1">
          <mxGeometry height="40" width="230" x="1505" y="6576" as="geometry" />
        </mxCell>
        <mxCell id="cabecalho_78" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Revisão" vertex="1">
          <mxGeometry height="40" width="230" x="1795" y="6576" as="geometry" />
        </mxCell>
        <mxCell id="cabecalho_79" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Encerramento" vertex="1">
          <mxGeometry height="40" width="230" x="2085" y="6576" as="geometry" />
        </mxCell>
        <mxCell id="cabecalho_80" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Ajustes de PR" vertex="1">
          <mxGeometry height="40" width="230" x="2375" y="6576" as="geometry" />
        </mxCell>
        <mxCell id="texto_81" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=7;fontSize=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" value="Retornar à etapa 4. As rodadas corretivas passam por implementação, revisão, encerramento e gate do PR; depois a revisão integral se repete." vertex="1">
          <mxGeometry height="48" width="2550" x="55" y="7004" as="geometry" />
        </mxCell>
        <mxCell id="texto_88" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=7;fontSize=15;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=19;" value="6 · Integrar e encerrar definitivamente — UC-ENC-03" vertex="1">
          <mxGeometry height="42" width="2610" x="30" y="7281" as="geometry" />
        </mxCell>
        <mxCell id="cabecalho_89" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;" value="CLI" vertex="1">
          <mxGeometry height="40" width="230" x="55" y="7343" as="geometry" />
        </mxCell>
        <mxCell id="cabecalho_90" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#f5f5f5;strokeColor=#666666;" value="HTTP" vertex="1">
          <mxGeometry height="40" width="230" x="345" y="7343" as="geometry" />
        </mxCell>
        <mxCell id="cabecalho_91" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Gestão de Demandas" vertex="1">
          <mxGeometry height="40" width="230" x="635" y="7343" as="geometry" />
        </mxCell>
        <mxCell id="cabecalho_92" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Execução" vertex="1">
          <mxGeometry height="40" width="230" x="925" y="7343" as="geometry" />
        </mxCell>
        <mxCell id="cabecalho_93" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Planejamento" vertex="1">
          <mxGeometry height="40" width="230" x="1215" y="7343" as="geometry" />
        </mxCell>
        <mxCell id="cabecalho_94" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Implementação" vertex="1">
          <mxGeometry height="40" width="230" x="1505" y="7343" as="geometry" />
        </mxCell>
        <mxCell id="cabecalho_95" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Revisão" vertex="1">
          <mxGeometry height="40" width="230" x="1795" y="7343" as="geometry" />
        </mxCell>
        <mxCell id="cabecalho_96" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Encerramento" vertex="1">
          <mxGeometry height="40" width="230" x="2085" y="7343" as="geometry" />
        </mxCell>
        <mxCell id="cabecalho_97" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=14;align=center;verticalAlign=middle;fillColor=#dae8fc;strokeColor=#6c8ebf;" value="Ajustes de PR" vertex="1">
          <mxGeometry height="40" width="230" x="2375" y="7343" as="geometry" />
        </mxCell>
        <mxCell id="texto_98" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=7;fontSize=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" value="O encerramento final não abre agente e não tem novo gate humano. Só a resolução de conflito exige trabalho do agente." vertex="1">
          <mxGeometry height="48" width="2550" x="55" y="7405" as="geometry" />
        </mxCell>
        <mxCell id="texto_99" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=7;fontSize=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" value="A delegação da resolução para Implementação representa reutilização lógica das verificações. O contrato entre esses serviços ainda precisa ser definido." vertex="1">
          <mxGeometry height="48" width="2550" x="55" y="8105" as="geometry" />
        </mxCell>
        <mxCell id="texto_120" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=7;fontSize=15;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=19;" value="Notas de escopo e caminhos transversais" vertex="1">
          <mxGeometry height="42" width="2610" x="30" y="9869" as="geometry" />
        </mxCell>
        <mxCell id="texto_121" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=7;fontSize=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" value="Cancelamento, antes da conclusão e quando permitido: HTTP → Gestão de Demandas → Execução para interromper o trabalho. Encerra o percurso ativo; o histórico permanece. Arquivamento posterior não integra este fluxo." vertex="1">
          <mxGeometry height="48" width="2550" x="55" y="9931" as="geometry" />
        </mxCell>
        <mxCell id="texto_122" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=7;fontSize=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" value="Acompanhamento, interrupção e reabertura passam por HTTP → Execução. Falhas, timeout ou reinício bloqueiam o escopo até a reabertura. Não há avanço automático de etapa após falha." vertex="1">
          <mxGeometry height="48" width="2550" x="55" y="10001" as="geometry" />
        </mxCell>
        <mxCell id="texto_123" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=7;fontSize=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" value="Pré-condição: projeto e execução configurados. Fora do diagrama: consultas, métricas, modelos de domínio e componentes de infraestrutura. CLI/HTTP são adaptadores, não executam regras das etapas." vertex="1">
          <mxGeometry height="48" width="2550" x="55" y="10071" as="geometry" />
        </mxCell>
        <mxCell id="texto_124" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=7;fontSize=15;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=14;" value="Este é um contrato visual proposto: mensagens nomeiam operações de aplicação, não endpoints existentes nem uma escolha entre chamadas síncronas e eventos. A ordem deve respeitar os gates e resultados indicados." vertex="1">
          <mxGeometry height="48" width="2550" x="55" y="10141" as="geometry" />
        </mxCell>
        <mxCell id="texto_131" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=7;fontSize=15;fillColor=#ffffff;fontSize=14;" value="7. Cancelar a demanda e dependentes elegíveis" vertex="1">
          <mxGeometry height="66" width="190" x="822" y="1172" as="geometry" />
        </mxCell>
        <mxCell id="texto_137" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=7;fontSize=15;fillColor=#ffffff;fontSize=14;" value="12. Selecionar planejamento elegível" vertex="1">
          <mxGeometry height="66" width="190" x="1112" y="1824" as="geometry" />
        </mxCell>
        <mxCell id="texto_143" parent="1" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;spacing=7;fontSize=15;fillColor=#ffffff;fontSize=14;" value="17. Retomar a mesma sessão para ajuste" vertex="1">
          <mxGeometry height="66" width="190" x="1402" y="2414" as="geometry" />
        </mxCell>

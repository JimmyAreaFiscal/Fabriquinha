        <mxCell id="r_LA35FQatkXShZi-ib0-56" parent="TuZLYwPetvcthj7BLmxr-13" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" value="&lt;h2 style=&quot;margin-top: 0px;&quot;&gt;EncerrarRodada&lt;/h2&gt;&lt;p&gt;&lt;/p&gt;&lt;h3&gt;Objetivo&lt;/h3&gt;O objetivo nesta etapa é documentar o que foi feito para manter o histórico e para dar evidências ao code reviewer humano (engenheiro)&lt;br&gt;&lt;br&gt;&lt;h3&gt;Problemas atuais:&lt;/h3&gt;1) falta de descrição do que foi realizado&lt;div&gt;2) PRs não padronizados e mensagens commits sem relação adequada&amp;nbsp;&lt;/div&gt;&lt;div&gt;3) falta de mensuração de custos e métricas das alterações&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;h3&gt;Evidências&lt;/h3&gt;&lt;div&gt;1) Mensagem PR&amp;nbsp;&lt;/div&gt;&lt;div&gt;2) Dados do trabalho (registro em banco de dados local)&amp;nbsp;&lt;/div&gt;&lt;div&gt;3) Explicação do Código&lt;/div&gt;&lt;div&gt;&lt;h3&gt;Métricas de Sucesso&lt;/h3&gt;&lt;/div&gt;&lt;div&gt;1) Quantidade de token/modelo e&amp;nbsp; custo total&amp;nbsp;&lt;/div&gt;&lt;div&gt;2) Feedback humano da qualidade (rating)&lt;/div&gt;&lt;p&gt;&lt;/p&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="440" width="324" x="1304" y="240" as="geometry" />
        </mxCell>

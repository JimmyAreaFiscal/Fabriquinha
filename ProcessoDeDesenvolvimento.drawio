        <mxCell id="r_LA35FQatkXShZi-ib0-21" value="&lt;h2 style=&quot;margin-top: 0px;&quot;&gt;DesenharSolucao&lt;/h2&gt;&lt;p&gt;&lt;/p&gt;&lt;h3&gt;Objetivo&lt;/h3&gt;O objetivo nesta etapa é desenhar a solução possível para o problema ou para a nova funcionalidade (conforme a necessidade/issue)&lt;br&gt;&lt;br&gt;&lt;h3&gt;Problemas atuais: &lt;/h3&gt;1) desenho complexo da solução&lt;br&gt;2) ampliação do que deve ser feito&lt;br&gt;&lt;br&gt;&lt;h3&gt;Evidências&lt;/h3&gt;&lt;div&gt;1) Desenho da Solução&amp;nbsp;&lt;/div&gt;&lt;div&gt;2) Protótipo (se for funcionalidade)&lt;/div&gt;&lt;div&gt;3) Relatório de Análise de Complexidade&lt;br&gt;&lt;br&gt;&lt;h3&gt;Métricas de Sucesso&lt;/h3&gt;&lt;/div&gt;&lt;div&gt;1) Quantidade de token/modelo e&amp;nbsp; custo total&amp;nbsp;&lt;/div&gt;&lt;div&gt;2) Quantidade de alterações/correções no desenho&lt;/div&gt;&lt;p&gt;&lt;/p&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="-230" y="440" width="290" height="420" as="geometry" />
        </mxCell>

        <mxCell id="r_LA35FQatkXShZi-ib0-38" value="Ticket de Revisão" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;labelPosition=center;verticalLabelPosition=top;align=center;verticalAlign=bottom;" vertex="1" parent="1">
          <mxGeometry x="1210" y="1001" width="40" height="40" as="geometry" />
        </mxCell>
        <mxCell id="r_LA35FQatkXShZi-ib0-43" value="&lt;h2 style=&quot;margin-top: 0px;&quot;&gt;RevisarSolucao&lt;/h2&gt;&lt;p&gt;&lt;/p&gt;&lt;h3&gt;Objetivo&lt;/h3&gt;O objetivo nesta etapa é revisar o que foi implementad, acrescentando tarefas de implementação em caso de problemas&lt;br&gt;&lt;br&gt;&lt;h3&gt;Problemas atuais: &lt;/h3&gt;1) complexidade elevada é enviada para PR&lt;br&gt;2) revisão altera funcionalidades ou problemas não envolvidos com o código modificado&lt;div&gt;3) adição de complexidade acidental&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;h3&gt;Evidências&lt;/h3&gt;&lt;div&gt;1) Critérios de Aceite com vídeos / imagens&lt;/div&gt;&lt;div&gt;2) Relatório Arquivos Alterados x Desenho Inicial&amp;nbsp;&lt;/div&gt;&lt;div&gt;3) Matriz de Fitness Functions com Explicações&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;h3&gt;Métricas de Sucesso&lt;/h3&gt;&lt;/div&gt;&lt;div&gt;1) Quantidade de token/modelo e&amp;nbsp; custo total&amp;nbsp;&lt;/div&gt;&lt;div&gt;2) Quantidade de exigências de alterações&lt;/div&gt;&lt;div&gt;3) Quantidade de bugs em arquivos revisados&lt;/div&gt;&lt;p&gt;&lt;/p&gt;&lt;/div&gt;" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;" vertex="1" parent="1">
          <mxGeometry x="1480" y="560" width="290" height="440" as="geometry" />
        </mxCell>

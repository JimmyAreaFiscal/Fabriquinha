        <mxCell id="TuZLYwPetvcthj7BLmxr-43" parent="r_LA35FQatkXShZi-ib0-90" style="text;html=1;whiteSpace=wrap;overflow=hidden;rounded=0;strokeColor=default;" value="&lt;h2 style=&quot;margin-top: 0px;&quot;&gt;RevisarEntregaDemanda&lt;/h2&gt;&lt;p&gt;&lt;/p&gt;&lt;h3&gt;Objetivo&lt;/h3&gt;O objetivo nesta etapa é revisar o que foi implementado na demanda e fazer adversarial review&lt;br&gt;&lt;br&gt;&lt;h3&gt;Problemas atuais: &lt;/h3&gt;1) Fuga da arquitetura original&lt;br&gt;2) Complexidade elevada&lt;div&gt;3) Falta de mensuração de requisitos não funcionais, como segurança e performance&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;h3&gt;Evidências&lt;/h3&gt;&lt;div&gt;1) Checagem de Critérios de Aceite da Demanda&amp;nbsp;&lt;/div&gt;&lt;div&gt;2) Testes de Estresse e Análise de Segurança&lt;/div&gt;&lt;div&gt;&lt;h3&gt;Métricas de Sucesso&lt;/h3&gt;&lt;/div&gt;&lt;div&gt;1) Quantidade de token/modelo e&amp;nbsp; custo total&amp;nbsp;&lt;/div&gt;&lt;div&gt;2) Quantidade de exigências de alterações&lt;/div&gt;&lt;div&gt;3) Quantidade de bugs em arquivos revisados&lt;/div&gt;&lt;p&gt;&lt;/p&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="440" width="290" x="2854" y="793" as="geometry" />
        </mxCell>
        <mxCell id="TuZLYwPetvcthj7BLmxr-44" parent="r_LA35FQatkXShZi-ib0-90" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;" value="Ticket de Revisão" vertex="1">
          <mxGeometry height="40" width="40" x="3201" y="1006" as="geometry" />
        </mxCell>
        <mxCell id="TuZLYwPetvcthj7BLmxr-45" edge="1" parent="r_LA35FQatkXShZi-ib0-90" source="TuZLYwPetvcthj7BLmxr-33" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" target="TuZLYwPetvcthj7BLmxr-44">
